# Copy to .env in the repo root or any cwd from which you run `chanl`.
# Load order: .env (dotenv) → env vars → ~/.chanl/config.json (config.json wins if set).

# ── CLI ──────────────────────────────────────────────────────────────────────
CHANL_SERVER_URL=http://localhost:18005/api/v1
CHANL_API_KEY=

# Provider for the agent under test: openai | anthropic | http
CHANL_PROVIDER=openai
CHANL_OPENAI_API_KEY=
CHANL_ANTHROPIC_API_KEY=

# HTTP adapter (test any REST endpoint)
CHANL_HTTP_ENDPOINT=
CHANL_HTTP_API_KEY=

# ── Server (packages/server) ────────────────────────────────────────────────
# MONGODB_URI=mongodb://localhost:27217/chanl-eval
# REDIS_URL=redis://localhost:6479
# PORT=18005

# Set to true to require X-API-Key on all routes (default: open for local dev)
# CHANL_EVAL_REQUIRE_API_KEY=true

# ── Docker ───────────────────────────────────────────────────────────────────
# `docker compose up` reads this file and passes CHANL_OPENAI_API_KEY /
# CHANL_ANTHROPIC_API_KEY / CHANL_SIMULATION_BASE_URL through to the server container.
#
# You do NOT have to set them here — the dashboard Settings page stores a key on the eval server
# instead, which is the easier path when you are just trying it out. Env vars are the better fit for
# CI and headless runs. Use either; a run needs a key from one of them.

# ── Simulation LLM (persona dialogue + LLM judge) ────────────────────────────
# Point the simulation half at any OpenAI-compatible endpoint — Ollama, OpenRouter, vLLM, Azure —
# while the agent under test stays wherever it lives. Running personas and the judge on a cheap
# local model is what makes a 100-scenario suite affordable.
# A base URL or a full endpoint both work; a base gets /v1/chat/completions appended.
# CHANL_SIMULATION_BASE_URL=http://host.docker.internal:11434/v1
